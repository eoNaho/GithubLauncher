<Window x:Class="GithubLauncher.MainWindow"
		xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
        xmlns:local="clr-namespace:GithubLauncher"
		xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
		xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        Title="Github Launcher"
		Width="1280" Height="720"
		MinWidth="750" MinHeight="490"
        Background="{Binding WindowBackground}"
		WindowState="Normal"
        WindowStartupLocation="CenterScreen"
		SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="{Binding ExtendClientAreaEnabled}"
        ExtendClientAreaChromeHints="{Binding ChromeHints}">

	<Window.Resources>
		<local:BooleanToStretchConverter x:Key="BooleanToStretchConverter"/>
		<local:ThicknessConverter x:Key="ThicknessConverter"/>

		<!-- Theme Resources -->
		<SolidColorBrush x:Key="BackgroundBase" Color="#0f111a"/>
		<SolidColorBrush x:Key="SidebarBackground" Color="#151722"/>
		<SolidColorBrush x:Key="Surface" Color="#1e2130"/>
		<SolidColorBrush x:Key="SurfaceAlt" Color="#2a2d3e"/>
		<SolidColorBrush x:Key="InputBackground" Color="#1a1d27"/>
		<SolidColorBrush x:Key="Hover" Color="#262a3d"/>
		<SolidColorBrush x:Key="Border" Color="#252938"/>
		<SolidColorBrush x:Key="Accent" Color="#6941f5"/>
		<SolidColorBrush x:Key="AccentHover" Color="#5835d6"/>
		<SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
		<SolidColorBrush x:Key="TextSecondary" Color="#8b949e"/>
		<SolidColorBrush x:Key="TextMuted" Color="#8b949e"/>
		<SolidColorBrush x:Key="StatusInstalled" Color="#2ea043"/>
		<SolidColorBrush x:Key="StatusUpdate" Color="#f59e0b"/>
		<SolidColorBrush x:Key="StatusDownload" Color="#8b949e"/>
		<SolidColorBrush x:Key="StatusNotInstalled" Color="#3b82f6"/>
		<SolidColorBrush x:Key="ThemeBase" Color="#1e2130"/>
		<SolidColorBrush x:Key="ThemeLighter" Color="#262a3d"/>
		<SolidColorBrush x:Key="ThemeDarker" Color="#0f111a"/>
		<SolidColorBrush x:Key="ThemeBorder" Color="#252938"/>
		<SolidColorBrush x:Key="ThemeText" Color="#ffffff"/>
		<SolidColorBrush x:Key="ThemeTextSecondary" Color="#8b949e"/>
		<SolidColorBrush x:Key="StatusInstalledBrush" Color="#2ea043"/>
		<SolidColorBrush x:Key="StatusUpdateBrush" Color="#f59e0b"/>
		<SolidColorBrush x:Key="StatusDownloadingBrush" Color="#8b949e"/>
		<SolidColorBrush x:Key="StatusNotInstalledBrush" Color="#3b82f6"/>
		<CornerRadius x:Key="CardRadius">12</CornerRadius>
		<CornerRadius x:Key="ControlRadius">8</CornerRadius>
		<GridLength x:Key="SidebarWidth">260</GridLength>
		<Thickness x:Key="MainContentPadding">28,20,28,28</Thickness>
		<Thickness x:Key="CardSpacing">10</Thickness>
		<Thickness x:Key="CardBottomSpacing">0,0,0,12</Thickness>

		<!-- list view -->
		<DataTemplate x:Key="ListViewTemplate">
			<Border Classes="gamecard" Height="{Binding ElementName=SlotSizeSlider, Path=Value}" Margin="{DynamicResource CardBottomSpacing}"
					PointerPressed="GameCard_PointerPressed">
				<Grid ClipToBounds="True">
					<Panel ClipToBounds="True">
						<Border CornerRadius="{DynamicResource CardRadius}" ClipToBounds="True">
							<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
								ClipToBounds="True"
								Height="{Binding ElementName=IconSizeSlider, Path=Value}"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								Opacity="{Binding ElementName=IconOpacitySlider, Path=Value}"
								Margin="{Binding ElementName=IconMarginSlider, Path=Value, Converter={StaticResource ThicknessConverter}}"
								Stretch="{Binding Path=IsChecked, ElementName=IconFillCheckBox, Converter={StaticResource BooleanToStretchConverter}}" />
						</Border>
					</Panel>
					<Border IsVisible="{Binding CanUpdate}"
							Background="{DynamicResource StatusUpdate}"
							CornerRadius="{DynamicResource ControlRadius}"
							Padding="8,3"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							Margin="12">
						<TextBlock Text="UPDATE" FontSize="10" FontWeight="Bold" Foreground="White"/>
					</Border>
					<Grid Margin="24">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Margin="{Binding ElementName=TextMarginSlider, Path=Value, Converter={StaticResource ThicknessConverter}}" VerticalAlignment="Center">
							<TextBlock Text="{Binding Name}"
									   FontSize="22"
									   FontWeight="Bold"
									   Foreground="{DynamicResource TextPrimary}"/>
							
							<TextBlock Text="{Binding StatusText}"
									   FontSize="13"
									   Foreground="{DynamicResource TextSecondary}"
									   Margin="0,6,0,0"/>

							<TextBlock Text="{Binding PlayTimeText}"
									   FontSize="12"
									   Foreground="{DynamicResource TextSecondary}"
									   Margin="0,4,0,0"
									   IsVisible="{Binding HasPlayTime}"
									   ToolTip.Tip="{Binding PlayTimeTooltip}"/>

							<StackPanel Orientation="Horizontal">
								<TextBlock Text="Latest: "
										   FontSize="12"
										   Foreground="{DynamicResource TextSecondary}"/>
								
								<TextBlock Text="{Binding LatestVersion}"
										   FontSize="12"
										   Foreground="{DynamicResource TextSecondary}"/>
							</StackPanel>
							<StackPanel Orientation="Horizontal"
										IsVisible="{Binding HasPreferredVersion}">
								<TextBlock Text="Preferred: "
										   FontSize="12"
										   Foreground="{DynamicResource TextSecondary}"/>

								<TextBlock Text="{Binding PreferredVersion}"
										   FontSize="12"
										   Foreground="{DynamicResource TextSecondary}"/>
							</StackPanel>
						</StackPanel>
						
						<!-- Gamecard: Options -->
						<StackPanel Grid.Column="1" 
									Orientation="Horizontal" 
									VerticalAlignment="Center"
									Spacing="12">
							<Button Classes="modern"
									Content="{Binding ButtonText}"
									FontSize="15"
									MinWidth="160"
									Height="48"
									IsEnabled="{Binding !IsLoading}"
									Click="GameButton_Click"
									Tag="{Binding}"/>

							<Button Classes="options options-listview"
									Content="⋯"
									FontSize="20"
									Height="48"
									Width="48"
									IsEnabled="{Binding !IsLoading}"
									Click="OptionsButton_Click"
									Tag="{Binding}">
								<Button.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Launch"
												  Click="LaunchGameMenu_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanLaunch}"/>
										<MenuItem Header="Download"
												  Click="LaunchGameMenu_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanDownload}"/>
										<MenuItem Header="Locate Existing Install"
												  Click="LocateExistingInstall_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanLocateInstall}"/>
										<MenuItem Header="Update Now"
												  Click="UpdateNowMenu_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanUpdate}"/>
										<MenuItem Header="Open Folder"
												  Click="OpenFolder_Click"
												  IsVisible="{Binding IsInstalled}"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Versions"
												  IsVisible="{Binding CanVersionOptions}">
											<MenuItem Header="Change Version"
													  Click="ChangeVersion_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding CanChangeVersion}"/>
											<MenuItem Header="Skip Update"
													  Click="SkipUpdate_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding CanSkipUpdate}"/>
											<MenuItem Header="Force Update"
													  Click="ForceUpdate_Click"
													  IsVisible="{Binding IsInstalled}"
													  CommandParameter="{Binding}"/>
										</MenuItem>
											<MenuItem Header="Launch Options"
												  IsVisible="{Binding CanLaunchOptions}">
											<MenuItem Header="Select Different Executable" 
													  CommandParameter="{Binding}" 
													  Click="SelectDifferentExecutable_Click"
													  IsVisible="{Binding HasExecutableChoice}"/>
											<MenuItem Header="Create Desktop Shortcut"
													  Click="CreateShortcut_Click"
													  IsVisible="{Binding IsInstalled}"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Add to Steam"
													  Click="AddToSteam_Click"
													  IsVisible="{Binding IsInstalled}"
													  CommandParameter="{Binding}"/>
										</MenuItem>
										<MenuItem Header="Customize">
											<MenuItem Header="Add Custom Image"
													  Click="SetCustomIcon_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Remove Custom Image"
													  Click="RemoveCustomIcon_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding HasCustomIcon}"/>
											<MenuItem Header="Add Hero Image"
													  Click="SetCustomHeroImage_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Download Hero Image"
													  Click="DownloadCustomHeroImage_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Remove Hero Image"
													  Click="RemoveCustomHeroImage_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding HasCustomHeroImage}"/>
											<MenuItem Header="Hide App"
													  Click="HideGame_Click"
													  CommandParameter="{Binding}"/>
										</MenuItem>
										<MenuItem Header="About"
												  IsVisible="{Binding CanInfoOptions}">
											<MenuItem Header="Show Changelog"
													  Click="ShowChangelog_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Open GitHub Page"
													  Click="OpenGitHubPage_Click"
													  CommandParameter="{Binding}"/>
										</MenuItem>
										<MenuItem Header="Delete"
												  Click="DeleteGameFromLibrary_Click"
												  IsVisible="{Binding IsInstalled}"
												  CommandParameter="{Binding}"/>
									</ContextMenu>
								</Button.ContextMenu>
							</Button>
						</StackPanel>
						<!-- Progress Bar -->
						<Border Grid.ColumnSpan="2"
								VerticalAlignment="Bottom"
								Height="4"
								CornerRadius="0,0,12,12"
								ClipToBounds="True"
								IsVisible="{Binding IsDownloading}">
							<ProgressBar Value="{Binding DownloadProgress}"
										 Minimum="0"
										 Maximum="100"
										 Height="4"
										 Background="Transparent"
										 Foreground="{Binding ProgressBarColor}"
										 BorderThickness="0"/>
						</Border>
					</Grid>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- grid view -->
		<DataTemplate x:Key="GridViewTemplate">
			<Border Classes="gamecardgrid"
					Width="{Binding ElementName=SlotSizeSlider, Path=Value}"
					Padding="12"
					PointerPressed="GameCard_PointerPressed">
				<Grid RowDefinitions="Auto,Auto,Auto">
					<Border Grid.Row="0"
							Height="120"
							CornerRadius="{DynamicResource ControlRadius}"
							ClipToBounds="True"
							Background="{DynamicResource SurfaceAlt}">
						<Grid ClipToBounds="True">
							<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
															ClipToBounds="True"
															Width="{Binding ElementName=IconSizeSlider, Path=Value}"
															Height="{Binding ElementName=IconSizeSlider, Path=Value}"
															VerticalAlignment="Center"
															HorizontalAlignment="Center"
															Opacity="{Binding ElementName=IconOpacitySlider, Path=Value}"
															Margin="{Binding ElementName=IconMarginSlider, Path=Value, Converter={StaticResource ThicknessConverter}}"
															Stretch="{Binding Path=IsChecked, ElementName=IconFillCheckBox, Converter={StaticResource BooleanToStretchConverter}}"/>
							<Border IsVisible="{Binding CanUpdate}"
									Background="{DynamicResource StatusUpdate}"
									CornerRadius="{DynamicResource ControlRadius}"
									Padding="8,3"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Margin="8">
								<TextBlock Text="UPDATE" FontSize="10" FontWeight="Bold" Foreground="White"/>
							</Border>
							<Button Classes="options-grid"
									Width="32"
									Height="32"
									VerticalAlignment="Top"
									HorizontalAlignment="Right"
									Margin="8"
									IsEnabled="{Binding !IsLoading}"
									Click="OptionsButton_Click"
									Tag="{Binding}">
								<StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Ellipse Width="3" Height="3" Fill="{DynamicResource TextPrimary}"/>
									<Ellipse Width="3" Height="3" Fill="{DynamicResource TextPrimary}"/>
									<Ellipse Width="3" Height="3" Fill="{DynamicResource TextPrimary}"/>
								</StackPanel>
								<Button.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Launch" Click="LaunchGameMenu_Click" CommandParameter="{Binding}" IsVisible="{Binding CanLaunch}"/>
										<MenuItem Header="Download" Click="LaunchGameMenu_Click" CommandParameter="{Binding}" IsVisible="{Binding CanDownload}"/>
										<MenuItem Header="Locate Existing Install" Click="LocateExistingInstall_Click" CommandParameter="{Binding}" IsVisible="{Binding CanLocateInstall}"/>
										<MenuItem Header="Update Now" Click="UpdateNowMenu_Click" CommandParameter="{Binding}" IsVisible="{Binding CanUpdate}"/>
										<MenuItem Header="Open Folder" Click="OpenFolder_Click" IsVisible="{Binding IsInstalled}" CommandParameter="{Binding}"/>
										<MenuItem Header="Change Version" Click="ChangeVersion_Click" CommandParameter="{Binding}" IsVisible="{Binding CanChangeVersion}"/>
										<MenuItem Header="Skip Update" Click="SkipUpdate_Click" CommandParameter="{Binding}" IsVisible="{Binding CanSkipUpdate}"/>
										<MenuItem Header="Force Update" Click="ForceUpdate_Click" IsVisible="{Binding IsInstalled}" CommandParameter="{Binding}"/>
										<MenuItem Header="Select Different Executable" CommandParameter="{Binding}" Click="SelectDifferentExecutable_Click" IsVisible="{Binding HasExecutableChoice}"/>
										<MenuItem Header="Create Desktop Shortcut" Click="CreateShortcut_Click" IsVisible="{Binding IsInstalled}" CommandParameter="{Binding}"/>
										<MenuItem Header="Add to Steam" Click="AddToSteam_Click" IsVisible="{Binding IsInstalled}" CommandParameter="{Binding}"/>
										<MenuItem Header="Add Custom Image" Click="SetCustomIcon_Click" CommandParameter="{Binding}"/>
										<MenuItem Header="Remove Custom Image" Click="RemoveCustomIcon_Click" CommandParameter="{Binding}" IsVisible="{Binding HasCustomIcon}"/>
										<MenuItem Header="Add Hero Image" Click="SetCustomHeroImage_Click" CommandParameter="{Binding}"/>
										<MenuItem Header="Download Hero Image" Click="DownloadCustomHeroImage_Click" CommandParameter="{Binding}"/>
										<MenuItem Header="Remove Hero Image" Click="RemoveCustomHeroImage_Click" CommandParameter="{Binding}" IsVisible="{Binding HasCustomHeroImage}"/>
										<MenuItem Header="Hide App" Click="HideGame_Click" CommandParameter="{Binding}"/>
										<MenuItem Header="Show Changelog" Click="ShowChangelog_Click" CommandParameter="{Binding}"/>
										<MenuItem Header="Open GitHub Page" Click="OpenGitHubPage_Click" CommandParameter="{Binding}"/>
										<MenuItem Header="Delete" Click="DeleteGameFromLibrary_Click" IsVisible="{Binding IsInstalled}" CommandParameter="{Binding}"/>
									</ContextMenu>
								</Button.ContextMenu>
							</Button>
						</Grid>
					</Border>

					<StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
						<TextBlock Text="{Binding Name}"
								   FontSize="14"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextPrimary}"
								   TextTrimming="CharacterEllipsis"
								   MaxLines="1"/>
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock Text="●"
									   FontSize="10"
									   Foreground="{Binding ButtonColor}"
									   VerticalAlignment="Center"/>
							<TextBlock Text="{Binding StatusText}"
									   FontSize="12"
									   Foreground="{DynamicResource TextSecondary}"
									   TextTrimming="CharacterEllipsis"
									   MaxLines="1"/>
						</StackPanel>
					</StackPanel>

					<Grid Grid.Row="2" ColumnDefinitions="*,32" Margin="0,8,0,0">
						<TextBlock Text="{Binding LatestVersion}"
								   FontSize="11"
								   Foreground="{DynamicResource TextMuted}"
								   VerticalAlignment="Center"
								   TextTrimming="CharacterEllipsis"/>
						<Button Grid.Column="1"
								Width="32"
								Height="32"
								Classes="modern-icon"
								IsEnabled="{Binding !IsLoading}"
								Click="GameButton_Click"
								Tag="{Binding}">
							<Image Width="32" Height="32" Source="{Binding ButtonImage}"/>
						</Button>
					</Grid>

					<Border Grid.RowSpan="3"
							VerticalAlignment="Bottom"
							Height="4"
							CornerRadius="0,0,12,12"
							ClipToBounds="True"
							IsVisible="{Binding IsDownloading}">
						<ProgressBar Value="{Binding DownloadProgress}"
									 Minimum="0"
									 Maximum="100"
									 Height="4"
									 Background="Transparent"
									 Foreground="{Binding ProgressBarColor}"
									 BorderThickness="0"/>
					</Border>
				</Grid>
			</Border>
		</DataTemplate>
	</Window.Resources>

	<Window.Styles>
	<Style Selector="Button.modern">
		<Setter Property="Background" Value="{Binding ButtonColor}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="20,10"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						CornerRadius="{DynamicResource ControlRadius}"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						FontSize="{TemplateBinding FontSize}"
						FontWeight="{TemplateBinding FontWeight}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- ComboBox Style -->
	<Style Selector="ComboBox">
		<Setter Property="Background" Value="{DynamicResource BackgroundBase}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
		<Setter Property="Padding" Value="12,8"/>
	</Style>

	<Style Selector="ComboBox:pointerover /template/ Border#Background">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
	</Style>

	<Style Selector="ComboBox:focus /template/ Border#Background">
		<Setter Property="Background" Value="{DynamicResource BackgroundBase}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
	</Style>

	<Style Selector="ComboBoxItem">
		<Setter Property="Background" Value="{DynamicResource BackgroundBase}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
		<Setter Property="Padding" Value="12,8"/>
	</Style>

	<Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
	</Style>

	<Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.modern:pointerover">
		<Setter Property="Opacity" Value="0.85"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.modern:pressed">
		<Setter Property="Opacity" Value="0.85"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<!-- Modern Icon Button Style for Grid View -->
	<Style Selector="Button.modern-icon">
		<Setter Property="Background" Value="{Binding ButtonColor}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						CornerRadius="{DynamicResource ControlRadius}"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Button.modern-icon:pointerover">
		<Setter Property="Opacity" Value="0.85"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.modern-icon:pressed">
		<Setter Property="Opacity" Value="0.85"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.options">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="Padding" Value="10"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource ControlRadius}"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						FontSize="{TemplateBinding FontSize}"
						FontWeight="{TemplateBinding FontWeight}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Button.options:pointerover">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.options:pressed">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.options.active">
		<Setter Property="Background" Value="{DynamicResource Accent}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
		<Setter Property="Foreground" Value="White"/>
	</Style>

	<Style Selector="Button.activityrow">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="8"/>
		<Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="Button.activityrow:pointerover">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
	</Style>

	<!-- Grid Options Button Style -->
	<Style Selector="Button.options-grid">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Opacity" Value="0"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						CornerRadius="{DynamicResource ControlRadius}"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						FontSize="{TemplateBinding FontSize}"
						FontWeight="{TemplateBinding FontWeight}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Border.gamecardgrid:pointerover Button.options-grid, Border.gamecardgrid:focus-within Button.options-grid">
		<Setter Property="Opacity" Value="1"/>
	</Style>

	<Style Selector="Button.options-grid:pointerover">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.options-grid:pressed">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.settings">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="12,10"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="Button.settings:pointerover">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.settings:pressed">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>
	
	<Style Selector="Button.iconbutton">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="Button.iconbutton:pointerover">
		<Setter Property="Opacity" Value="0.7"/>
	</Style>

	<Style Selector="Button.iconbutton:pressed">
		<Setter Property="Opacity" Value="0.5"/>
	</Style>

	<Style Selector="Border.gamecard">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
		<Setter Property="Margin" Value="{DynamicResource CardBottomSpacing}"/>
	</Style>

	<Style Selector="Border.gamecardgrid">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
		<Setter Property="Margin" Value="0,0,20,20"/>
	</Style>

	<Style Selector="ContextMenu">
		<Setter Property="Background" Value="{DynamicResource BackgroundBase}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="4"/>
		<Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
	</Style>

	<Style Selector="MenuItem">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="Padding" Value="10,8"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>

	<Style Selector="MenuItem /template/ Border#PART_PopupBorder">
		<Setter Property="Background" Value="{DynamicResource BackgroundBase}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
		<Setter Property="Padding" Value="4"/>
	</Style>

	<Style Selector="MenuItem:selected">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
	</Style>

	<Style Selector="MenuItem:focus">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="MenuItem:focus-visible">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<!-- Focus Visual Styles -->
	<Style Selector="Button:focus">
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="Button:focus /template/ Border">
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="Button.modern:focus /template/ Border">
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="Button.modern-icon:focus /template/ Border">
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="Button.options:focus /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>

	<Style Selector="Button.options-grid:focus /template/ Border">
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Opacity" Value="1"/>
	</Style>

	<Style Selector="Button.options-grid:focus">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
	</Style>

	<Style Selector="Button.settings:focus">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.iconbutton:focus">
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="CheckBox:focus /template/ Border#NormalRectangle">
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Slider:focus /template/ Thumb">
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>

	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<!-- Theme-aware text styles -->
	<Style Selector="TextBlock.theme-text">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="TextBlock.theme-text-secondary">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
	</Style>

	<Style Selector="TextBlock.theme-text-muted">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
		<Setter Property="Opacity" Value="0.7"/>
	</Style>

	<Style Selector="TabItem">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
		<Setter Property="Padding" Value="14,4"/>
		<Setter Property="Margin" Value="4,8,4,0"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="CornerRadius" Value="6"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="MinHeight" Value="42"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="TabItem:selected">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="TabItem:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="TextBlock.section-title">
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="Margin" Value="0,0,0,16"/>
	</Style>

	<Style Selector="Border.badge">
		<Setter Property="Background" Value="{DynamicResource Accent}"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Padding" Value="8,2"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.navlink">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="18,13"/>
		<Setter Property="MinHeight" Value="48"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="Button.navlink:pointerover">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Button.navlink.active">
		<Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
		<Setter Property="BorderThickness" Value="3,0,0,0"/>
	</Style>

	<Style Selector="Button.navlink Path">
		<Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
	</Style>

	<Style Selector="Button.window-control Path">
		<Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
	</Style>

	<Style Selector="TextBox.search">
		<Setter Property="Background" Value="{DynamicResource InputBackground}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Padding" Value="40,10,16,10"/>
		<Setter Property="FontSize" Value="14"/>
	</Style>

	<Style Selector="Button.top-action">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="10,6"/>
		<Setter Property="CornerRadius" Value="18"/>
		<Setter Property="MinHeight" Value="44"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="Button.top-action:pointerover">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
	</Style>

	<Style Selector="Button.round-icon">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Width" Value="36"/>
		<Setter Property="Height" Value="36"/>
		<Setter Property="CornerRadius" Value="18"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="Button.window-control">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Width" Value="18"/>
		<Setter Property="Height" Value="36"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="Button.window-control:pointerover">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="Border.hero-banner">
		<Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
		<Setter Property="CornerRadius" Value="16"/>
		<Setter Property="Height" Value="240"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Margin" Value="0,0,0,40"/>
	</Style>

	<Style Selector="Button.category-card">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
		<Setter Property="Padding" Value="16"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="VerticalContentAlignment" Value="Stretch"/>
	</Style>

	<Style Selector="Button.category-card:pointerover">
		<Setter Property="Background" Value="{DynamicResource Hover}"/>
	</Style>

	<Style Selector="Button.category-card.selected">
		<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
	</Style>

</Window.Styles>

<Border CornerRadius="24" ClipToBounds="True" Background="Transparent">
	<Grid x:Name="MainGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="260"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
		<Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
			<Grid Margin="18,24,18,16">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>	
				</Grid.RowDefinitions>

				<!-- Logo/Header -->
				<StackPanel Grid.Row="0" Margin="0,0,0,32" HorizontalAlignment="Center">
					<Image anim:ImageBehavior.AnimatedSource="avares://GithubLauncher/Assets/app.gif"
						   Width="90"
						   Height="90"
						   HorizontalAlignment="Center"
						   Margin="0,0,0,15"/>
					<TextBlock Text="GITHUB"
							   FontSize="18"
							   FontWeight="Bold"
							   Foreground="{DynamicResource TextPrimary}"
							   HorizontalAlignment="Center"
							   LetterSpacing="2"/>
					<TextBlock Text="LAUNCHER"
							   FontSize="11"
							   FontWeight="Medium"
							   Foreground="{DynamicResource TextMuted}"
							   HorizontalAlignment="Center"
							   LetterSpacing="3"
							   Margin="0,2,0,0"/>
				</StackPanel>

				<!-- Navigation -->
				<StackPanel Grid.Row="1" VerticalAlignment="Top" Spacing="8" HorizontalAlignment="Stretch">
						<Button x:Name="ContinueButton"
								Classes="navlink active"
								Click="HomeButton_Click">
							<Grid ColumnDefinitions="28,*,Auto">
								<Path Grid.Column="0" Data="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10"
									  Width="16" Height="16" Stretch="Uniform"
									  Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
									  VerticalAlignment="Center" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="1" Text="Home" VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<Button x:Name="ActivityButton"
								Classes="navlink"
								Click="ActivityButton_Click">
							<Grid ColumnDefinitions="28,*">
								<Path Grid.Column="0" Data="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z M12 6v6l4 2"
									  Width="16" Height="16" Stretch="Uniform"
									  Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
									  VerticalAlignment="Center" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="1" Text="Activity" VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<Button x:Name="ManageGamesButton"
								Classes="navlink"
								Click="ManageGamesButton_Click">
							<Grid ColumnDefinitions="28,*">
								<Path Grid.Column="0" Data="M3 3h7v7H3zm11 0h7v7h-7zm0 11h7v7h-7zM3 14h7v7H3z"
									  Width="16" Height="16" Stretch="Uniform"
									  Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
									  VerticalAlignment="Center" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="1" Text="Library" VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<Button x:Name="SettingsButton"
								Classes="navlink"
								Click="SettingsButton_Click">
							<Grid ColumnDefinitions="28,*">
								<Path Grid.Column="0" Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
									  Width="16" Height="16" Stretch="Uniform"
									  Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
									  VerticalAlignment="Center" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"/>
							</Grid>
						</Button>
					</StackPanel>

				<StackPanel Grid.Row="2" Margin="0,30,0,10">
					<TextBlock Text="COMMUNITY"
							   FontSize="10"
							   FontWeight="Bold"
							   Foreground="{DynamicResource TextMuted}"
							   LetterSpacing="0.5"
							   Margin="16,0,0,8"/>
				</StackPanel>

				<ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="8" HorizontalAlignment="Stretch">
							<Button Classes="navlink"
									Click="GithubButton_Click">
								<Grid ColumnDefinitions="28,*">
									<Path Grid.Column="0" Data="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
										  Width="16" Height="16" Stretch="Uniform"
										  Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
										  VerticalAlignment="Center" HorizontalAlignment="Center"/>
									<TextBlock Grid.Column="1" Text="GitHub" VerticalAlignment="Center"/>
								</Grid>
							</Button>

							<Button Classes="navlink"
									Click="ForkButton_Click">
								<Grid ColumnDefinitions="28,*">
									<Path Grid.Column="0" Data="M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm0 0v2a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V3m-6 8v6m-6-6a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm12 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
										  Width="16" Height="16" Stretch="Uniform"
										  Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
										  VerticalAlignment="Center" HorizontalAlignment="Center"/>
									<TextBlock Grid.Column="1" Text="Our Fork" VerticalAlignment="Center"/>
								</Grid>
							</Button>

							<Button Classes="navlink"
									Click="KofiButton_Click">
								<Grid ColumnDefinitions="28,*">
									<Path Grid.Column="0" Data="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
										  Width="16" Height="16" Stretch="Uniform"
										  Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
										  VerticalAlignment="Center" HorizontalAlignment="Center"/>
									<TextBlock Grid.Column="1" Text="Donate" VerticalAlignment="Center"/>
								</Grid>
							</Button>
						</StackPanel>
				</ScrollViewer>

				<Border Grid.Row="4"
						Background="{DynamicResource Surface}"
						CornerRadius="12"
						Padding="12"
						HorizontalAlignment="Stretch">
					<Grid ColumnDefinitions="36,*,Auto">
						<Border Grid.Column="0"
								Width="36"
								Height="36"
								CornerRadius="18"
								Background="{DynamicResource SurfaceAlt}">
							<TextBlock Text="N"
									   Foreground="{DynamicResource TextPrimary}"
									   FontSize="14"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Border>
						<StackPanel Grid.Column="1" Margin="12,0,0,0">
							<TextBlock Text="Naho"
									   Foreground="{DynamicResource TextPrimary}"
									   FontSize="14"
									   FontWeight="SemiBold"/>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<Ellipse Width="6" Height="6" Fill="{DynamicResource StatusInstalled}" VerticalAlignment="Center"/>
								<TextBlock Text="Online"
										   Foreground="{DynamicResource StatusInstalled}"
										   FontSize="12"/>
							</StackPanel>
						</StackPanel>
						<TextBlock Grid.Column="2" Text="⌄" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
					</Grid>
				</Border>
			</Grid>
		</Border>

		<!-- Main Content Area -->
		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top Bar -->
			<Border Grid.Row="0"
					Background="{DynamicResource BackgroundBase}"
					Padding="32,24,32,8"
					ZIndex="1"
					PointerPressed="TopBar_PointerPressed">
				<Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
					<TextBlock x:Name="HeaderTitleText"
							   Text="Library"
							   IsVisible="False"/>
					<CheckBox x:Name="ShowUpdatesOnlyCheckBox"
							  IsVisible="False"
							  Checked="ShowUpdatesOnlyCheckBox_Checked"
							  Unchecked="ShowUpdatesOnlyCheckBox_Unchecked"/>
					<Button x:Name="UnhideAllGamesButton"
							IsVisible="False"
							Click="UnhideAllGamesButton_Click"/>
					<Button x:Name="HideNonInstalledButton"
							IsVisible="False"
							Click="HideNonInstalledButton_Click"/>
					<ComboBox x:Name="SortByComboBox"
							  IsVisible="False"
							  SelectionChanged="SortByComboBox_SelectionChanged">
						<ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
						<ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
						<ComboBoxItem Content="Installed First" Tag="Installed"/>
						<ComboBoxItem Content="Not Installed First" Tag="NotInstalled"/>
						<ComboBoxItem Content="Last Played" Tag="LastPlayed"/>
					</ComboBox>

					<Grid Grid.Column="0" Width="300">
						<Path Data="M21 21L16.65 16.65M10.5 18A7.5 7.5 0 1 1 10.5 3A7.5 7.5 0 0 1 10.5 18"
							  Width="16"
							  Height="16"
							  Stretch="Uniform"
							  Fill="Transparent"
							  Stroke="{DynamicResource TextMuted}"
							  StrokeThickness="2"
							  StrokeLineCap="Round"
							  StrokeJoin="Round"
							  Margin="16,0,0,0"
							  VerticalAlignment="Center"
							  HorizontalAlignment="Left"
							  ZIndex="1"/>
						<TextBox x:Name="LibrarySearchTextBox"
								 Classes="search"
								 Watermark="Search apps..."
								 TextChanged="LibrarySearchTextBox_TextChanged"/>
					</Grid>

					<StackPanel Grid.Column="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Spacing="16">
						<Grid>
							<Button x:Name="NotificationsButton"
									Classes="round-icon"
									ToolTip.Tip="Notifications"
									Click="NotificationsButton_Click">
								<Path Data="M18 8A6 6 0 0 0 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8M13.73 21A2 2 0 0 1 10.27 21"
									  Width="16"
									  Height="16"
									  Stretch="Uniform"
									  Fill="Transparent"
									  Stroke="{DynamicResource TextPrimary}"
									  StrokeThickness="2"
									  StrokeLineCap="Round"
									  StrokeJoin="Round"/>
							</Button>
							<Border Classes="badge"
									IsVisible="{Binding HasUnreadNotifications}"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									Margin="0,-4,-4,0"
									MinWidth="16"
									Height="16"
									Padding="4,0"
									IsHitTestVisible="False">
								<TextBlock Text="{Binding NotificationUnreadCount}"
										   FontSize="9"
										   FontWeight="Bold"
										   Foreground="White"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center"/>
							</Border>
						</Grid>

						<Button Classes="top-action"
								ToolTip.Tip="{Binding UpdateButtonSubtitle}"
								Click="CheckforUpdates_Click">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Border Width="32"
										Height="32"
										CornerRadius="8"
										Background="{DynamicResource SurfaceAlt}">
									<Path Data="M21 12A9 9 0 0 0 6 5.3L3 8M3 3V8H8M3 12A9 9 0 0 0 18 18.7L21 16M21 21V16H16"
										  Width="16"
										  Height="16"
										  Stretch="Uniform"
										  Fill="Transparent"
										  Stroke="{DynamicResource TextPrimary}"
										  StrokeThickness="2"
										  StrokeLineCap="Round"
										  StrokeJoin="Round"
										  RenderTransformOrigin="0.5,0.5"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center">
										<Path.RenderTransform>
											<RotateTransform Angle="{Binding UpdateIconAngle}"/>
										</Path.RenderTransform>
									</Path>
								</Border>
								<StackPanel VerticalAlignment="Center" Spacing="1">
									<TextBlock Text="{Binding UpdateButtonTitle}"
											   FontSize="12"
											   FontWeight="Bold"
											   Foreground="{DynamicResource TextPrimary}"/>
									<TextBlock Text="{Binding UpdateButtonSubtitle}"
											   FontSize="11"
											   Foreground="{DynamicResource TextMuted}"/>
								</StackPanel>
								<Border Classes="badge" IsVisible="{Binding HasUpdates}">
									<TextBlock Text="{Binding UpdateCount}" FontSize="10" FontWeight="Bold" Foreground="White"/>
								</Border>
							</StackPanel>
						</Button>

						<Button x:Name="DownloadsButton"
								Classes="top-action"
								Click="DownloadsButton_Click">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Path Data="M21 15V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V15M7 10L12 15L17 10M12 15V3"
									  Width="16"
									  Height="16"
									  Stretch="Uniform"
									  Fill="Transparent"
									  Stroke="{DynamicResource TextPrimary}"
									  StrokeThickness="2"
									  StrokeLineCap="Round"
									  StrokeJoin="Round"
									  VerticalAlignment="Center"/>
								<TextBlock Text="Downloads" VerticalAlignment="Center"/>
								<Border Classes="badge" Background="{DynamicResource SurfaceAlt}" IsVisible="{Binding HasDownloads}">
									<TextBlock Text="{Binding DownloadCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
								</Border>
							</StackPanel>
						</Button>

						<StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,0">
							<Button Classes="window-control" Click="MinimizeButton_Click">
								<Path Data="M5 12h14" Width="10" Height="10" Stretch="Uniform" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Button>
							<Button Classes="window-control" Click="ToggleFullscreen_Click">
								<Path Data="M3 3h18v18H3z" Width="10" Height="10" Stretch="Uniform" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Button>
							<Button Classes="window-control" Click="CloseLauncher_Click">
								<Path Data="M18 6L6 18M6 6l12 12" Width="10" Height="10" Stretch="Uniform" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Button>
						</StackPanel>
					</StackPanel>
				</Grid>
			</Border>

			<!-- Apps Content with Settings Panel Overlay -->
			<Grid Grid.Row="1">

				<!-- Background Image -->
				<Border Background="{DynamicResource BackgroundBase}"/>
				<Image x:Name="CustomBackgroundImage"
					anim:ImageBehavior.AnimatedSource="{Binding BackgroundImageUri}"
					Stretch="Fill"
					Opacity="{Binding BackgroundOpacity}"/>
				<Image x:Name="StaticBackgroundImage"
					Source="{Binding BackgroundImageUri}"
					Stretch="Fill"
					Opacity="{Binding BackgroundOpacity}"/>

				<!-- Main Content -->
				<ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="GameScrollViewer" Margin="32,20,32,32">
					<StackPanel>
						<TextBlock Text="Featured"
								   Classes="section-title"
								   IsVisible="{Binding IsFeaturedVisible}"/>

						<Border Classes="hero-banner"
								ClipToBounds="True"
								IsVisible="{Binding IsFeaturedVisible}">
							<Grid ClipToBounds="True">
								<Border Background="#1a2235"/>
								<asyncImageLoader:AdvancedImage Source="{Binding FeaturedGameInfo.HeroImageSource}"
																Stretch="UniformToFill"
																Opacity="0.78"/>
								<Border>
									<Border.Background>
										<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
											<GradientStop Color="#e6141621" Offset="0"/>
											<GradientStop Color="#cc141621" Offset="0.34"/>
											<GradientStop Color="#66141621" Offset="0.62"/>
											<GradientStop Color="#24141621" Offset="1"/>
										</LinearGradientBrush>
									</Border.Background>
								</Border>
								<Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16"/>

								<StackPanel MaxWidth="420"
											VerticalAlignment="Center"
											HorizontalAlignment="Left"
											Margin="40,0,0,0">
									<TextBlock Text="{Binding FeaturedGameInfo.Name}"
											   FontSize="28"
											   FontWeight="Bold"
											   Foreground="{DynamicResource TextPrimary}"
											   TextWrapping="Wrap"
											   LineHeight="34"
											   Margin="0,0,0,12"/>
									<TextBlock Text="{Binding FeaturedGameInfo.Repository}"
											   FontSize="14"
											   Foreground="{DynamicResource TextMuted}"
											   TextWrapping="Wrap"
											   MaxWidth="400"
											   Margin="0,0,0,24"/>
									<StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="✓" Foreground="{DynamicResource StatusInstalled}" FontSize="14"/>
											<TextBlock Text="{Binding FeaturedGameInfo.StatusText}" Foreground="{DynamicResource StatusInstalled}" FontSize="13"/>
										</StackPanel>
										<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding FeaturedGameInfo.HasPlayTime}">
											<TextBlock Text="◷" Foreground="{DynamicResource TextMuted}" FontSize="14"/>
											<TextBlock Text="{Binding FeaturedGameInfo.PlayTimeText}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
										</StackPanel>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="12">
										<Button Classes="modern"
												MinWidth="140"
												Height="44"
												Background="{DynamicResource Accent}"
												Click="FeaturedGameButton_Click">
											<StackPanel Orientation="Horizontal" Spacing="10">
												<Path Data="M8 5V19L19 12Z"
													  Width="13"
													  Height="13"
													  Stretch="Uniform"
													  Fill="{DynamicResource TextPrimary}"
													  VerticalAlignment="Center"/>
												<TextBlock Text="Play"/>
											</StackPanel>
										</Button>
										<Button Classes="options"
												Width="44"
												Height="44"
												Click="FeaturedGameOptionsButton_Click"
												Tag="{Binding FeaturedGameInfo}">
											<Grid Width="18" Height="18">
												<Ellipse Width="9" Height="9"
														 Stroke="{DynamicResource TextPrimary}"
														 StrokeThickness="2"
														 Fill="Transparent"
														 HorizontalAlignment="Center"
														 VerticalAlignment="Center"/>
												<Path Data="M9 0V4M9 14V18M0 9H4M14 9H18M2.6 2.6L5.4 5.4M12.6 12.6L15.4 15.4M15.4 2.6L12.6 5.4M5.4 12.6L2.6 15.4"
													  Width="18"
													  Height="18"
													  Stretch="Uniform"
													  Fill="Transparent"
													  Stroke="{DynamicResource TextPrimary}"
													  StrokeThickness="1.8"
													  StrokeLineCap="Round"/>
											</Grid>
										</Button>
										<Button Classes="options"
												Width="44"
												Height="44"
												Click="FeaturedGameOptionsButton_Click"
												Tag="{Binding FeaturedGameInfo}">
											<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
												<Ellipse Width="4" Height="4" Fill="{DynamicResource TextPrimary}"/>
												<Ellipse Width="4" Height="4" Fill="{DynamicResource TextPrimary}"/>
												<Ellipse Width="4" Height="4" Fill="{DynamicResource TextPrimary}"/>
											</StackPanel>
										</Button>
									</StackPanel>
								</StackPanel>

								<StackPanel Orientation="Horizontal"
											Spacing="8"
											HorizontalAlignment="Center"
											VerticalAlignment="Bottom"
											Margin="0,0,0,20">
									<Border Width="24" Height="8" CornerRadius="4" Background="{DynamicResource Accent}"/>
									<Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource TextMuted}" Opacity="0.45"/>
									<Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource TextMuted}" Opacity="0.45"/>
									<Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource TextMuted}" Opacity="0.45"/>
								</StackPanel>
							</Grid>
						</Border>

						<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
							<TextBlock Text="Library"
									   Classes="section-title"
									   Margin="0"/>
							<Button Grid.Column="1"
									Classes="options"
									Content="View all ›"
									FontSize="12"
									Padding="12,6"
									Click="UnhideAllGamesButton_Click"/>
						</Grid>

						<Grid>
							<ItemsControl ItemsSource="{Binding FilteredGames}" x:Name="ListViewControl"
										  IsVisible="{Binding ElementName=UseGridViewCheckBox, Path=!IsChecked}">
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="ListViewTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding FilteredGames}" x:Name="GridViewControl"
										  IsVisible="{Binding ElementName=UseGridViewCheckBox, Path=IsChecked}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="GridViewTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock x:Name="LibraryNoResultsText"
									   Text="Nenhum app encontrado."
									   FontSize="14"
									   Foreground="{DynamicResource TextSecondary}"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"
									   IsVisible="False"/>
							<Border x:Name="EmptyStateOverlay"
									IsVisible="False"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Padding="40,32"
									CornerRadius="{DynamicResource CardRadius}"
									Background="{DynamicResource Surface}"
									BorderBrush="{DynamicResource Border}"
									BorderThickness="1">
								<StackPanel Spacing="12" HorizontalAlignment="Center">
									<TextBlock Text="Nenhum app configurado"
											   FontSize="18"
											   FontWeight="Bold"
											   Foreground="{DynamicResource TextPrimary}"
											   HorizontalAlignment="Center"/>
									<TextBlock Text="Abra o gerenciador para procurar e adicionar apps do catálogo."
											   FontSize="13"
											   Foreground="{DynamicResource TextSecondary}"
											   HorizontalAlignment="Center"
											   TextWrapping="Wrap"
											   MaxWidth="360"/>
									<Button Classes="options"
											Content="Abrir gerenciador"
											HorizontalAlignment="Center"
											MinWidth="180"
											Height="40"
											Click="EmptyStateOpenAppManager_Click"/>
								</StackPanel>
							</Border>
						</Grid>

						<TextBlock Text="Categories"
								   Classes="section-title"
								   Margin="0,24,0,16"/>
						<WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
							<!-- Gamecube / Wii Ports Card -->
							<Button Classes="category-card" Classes.selected="{Binding IsGamecubeWiiFilterActive}" Width="195" Margin="0,0,12,12"
									Click="CategoryFilterCard_Click" CommandParameter="GamecubeWii">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="G" Foreground="#3b82f6" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="Gamecube / Wii" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
										<TextBlock Text="{Binding GamecubeWiiCount, StringFormat={}{0} apps}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
									</StackPanel>
								</StackPanel>
							</Button>

							<!-- N64 Ports Card -->
							<Button Classes="category-card" Classes.selected="{Binding IsN64FilterActive}" Width="195" Margin="0,0,12,12"
									Click="CategoryFilterCard_Click" CommandParameter="N64">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="N" Foreground="#eab308" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="N64 Ports" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
										<TextBlock Text="{Binding N64PortsCount, StringFormat={}{0} apps}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
									</StackPanel>
								</StackPanel>
							</Button>

							<!-- PlayStation Ports Card -->
							<Button Classes="category-card" Classes.selected="{Binding IsPlayStationFilterActive}" Width="195" Margin="0,0,12,12"
									Click="CategoryFilterCard_Click" CommandParameter="PlayStation">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="P" Foreground="#a855f7" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="PlayStation" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
										<TextBlock Text="{Binding PlayStationCount, StringFormat={}{0} apps}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
									</StackPanel>
								</StackPanel>
							</Button>

							<!-- 2D Game Ports Card -->
							<Button Classes="category-card" Classes.selected="{Binding Is2DGameFilterActive}" Width="195" Margin="0,0,12,12"
									Click="CategoryFilterCard_Click" CommandParameter="2DGame">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="2" Foreground="#10b981" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="2D Game Ports" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
										<TextBlock Text="{Binding TwoDGamePortsCount, StringFormat={}{0} apps}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
									</StackPanel>
								</StackPanel>
							</Button>

							<!-- Xbox 360 Ports Card -->
							<Button Classes="category-card" Classes.selected="{Binding IsXbox360FilterActive}" Width="195" Margin="0,0,12,12"
									Click="CategoryFilterCard_Click" CommandParameter="Xbox360">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="X" Foreground="#22c55e" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="Xbox 360" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
										<TextBlock Text="{Binding Xbox360Count, StringFormat={}{0} apps}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
									</StackPanel>
								</StackPanel>
							</Button>

							<!-- System Emulation Card -->
							<Button Classes="category-card" Classes.selected="{Binding IsSystemEmulationFilterActive}" Width="195" Margin="0,0,12,12"
									Click="CategoryFilterCard_Click" CommandParameter="SystemEmulation">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="E" Foreground="#ef4444" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="System Emulation" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
										<TextBlock Text="{Binding SystemEmulationCount, StringFormat={}{0} apps}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
									</StackPanel>
								</StackPanel>
							</Button>

							<!-- Other Ports Card -->
							<Button Classes="category-card" Classes.selected="{Binding IsOtherPortsFilterActive}" Width="195" Margin="0,0,12,12"
									Click="CategoryFilterCard_Click" CommandParameter="OtherPorts">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="O" Foreground="#9ca3af" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="Other Ports" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
										<TextBlock Text="{Binding OtherPortsCount, StringFormat={}{0} apps}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
									</StackPanel>
								</StackPanel>
							</Button>

							<!-- All Categories Card -->
							<Button Classes="category-card" Classes.selected="{Binding IsAllCategoriesFilterActive}" Width="195" Margin="0,0,12,12"
									Click="CategoryFilterCard_Click" CommandParameter="All">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="A" Foreground="#8a2be2" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="All Categories" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
										<TextBlock Text="{Binding LibraryCount, StringFormat={}{0} apps}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
									</StackPanel>
								</StackPanel>
							</Button>
						</WrapPanel>
					</StackPanel>
				</ScrollViewer>

				<!-- Settings Page -->
				<Border x:Name="SettingsPanel"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Background="{DynamicResource BackgroundBase}"
						IsVisible="False">
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
					              Padding="40,0,40,0">
						<StackPanel x:Name="SettingsContent"
						            Margin="0,0,0,48">

							<!-- Settings Header -->
							<Border Padding="32,28,32,20"
									BorderThickness="0,0,0,1"
									BorderBrush="{DynamicResource Border}">
								<TextBlock Text="Settings"
										   FontSize="28"
										   FontWeight="Bold"
										   Foreground="{DynamicResource TextPrimary}"/>
							</Border>

							<!-- Tab Control -->
							<TabControl Background="Transparent"
										Foreground="{DynamicResource TextPrimary}"
										Padding="24,8,24,0"
										Margin="0">

								<!-- General Tab -->
								<TabItem Header="General">
									<StackPanel Margin="0,16,0,24" Spacing="8">

										<!-- Behaviour -->
										<TextBlock Text="BEHAVIOUR"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="EnableGamepadCheckBox"
													  Content="Enable Gamepad Input"
													  Foreground="{DynamicResource TextPrimary}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="EnableGamepadCheckBox_Checked"
													  Unchecked="EnableGamepadCheckBox_Unchecked"/>
											<TextBlock Text="Allow controller navigation inside the launcher"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2">
											<CheckBox x:Name="CloseAfterLaunchCheckBox"
													  Content="Close After Launch"
													  Foreground="{DynamicResource TextPrimary}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="CloseAfterLaunchCheckBox_Checked"
													  Unchecked="CloseAfterLaunchCheckBox_Unchecked"/>
											<TextBlock Text="Close the launcher automatically after starting an app"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2">
											<CheckBox x:Name="EnableNotificationsCheckBox"
													  Content="Enable Notifications"
													  Foreground="{DynamicResource TextPrimary}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="EnableNotificationsCheckBox_Checked"
													  Unchecked="EnableNotificationsCheckBox_Unchecked"/>
											<TextBlock Text="Show OS notifications for downloads, updates and streaks"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- Install Path -->
										<TextBlock Text="APP INSTALL PATH"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="Leave blank to use the default location"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondary}"
												   Margin="0,0,0,4"/>

										<Panel HorizontalAlignment="Stretch">
											<TextBox x:Name="GamePathTextBox"
													 Foreground="{DynamicResource TextPrimary}"
													 Background="{DynamicResource Surface}"
													 BorderBrush="{DynamicResource Border}"
													 BorderThickness="1"
													 Padding="12,10"
													 CornerRadius="4"
													 Margin="0,0,44,0"
													 TextChanged="GamePathTextBox_TextChanged"
													 Text="{Binding Settings.GamesPath, Mode=TwoWay}"/>
											<Button Classes="options"
													HorizontalAlignment="Right"
													Width="40"
													Height="40"
													Content="📁"
													Click="BrowseGamePath_Click"/>
										</Panel>

										<Button Classes="options"
												Content="Reset to Default"
												HorizontalAlignment="Stretch"
												Click="ClearGamePath_Click"
												FontSize="12"/>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- Platform & Cache -->
										<TextBlock Text="PLATFORM &amp; CACHE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="{Binding PlatformString}"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Change Platform"
												HorizontalAlignment="Stretch"
												Click="OptionsButton_Click"
												Tag="{Binding}"
												FontSize="12">
											<Button.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Automatic"   Click="PlatformAuto_Click"/>
													<MenuItem Header="Windows"     Click="PlatformWindows_Click"/>
													<MenuItem Header="MacOS"       Click="PlatformMacOS_Click"/>
													<MenuItem Header="Linux X64"   Click="PlatformLinuxX64_Click"/>
													<MenuItem Header="Linux ARM64" Click="PlatformLinuxARM64_Click"/>
												</ContextMenu>
											</Button.ContextMenu>
										</Button>

										<Button Classes="options"
												Content="Clear Icon Cache"
												HorizontalAlignment="Stretch"
												Click="ClearIconCache_Click"
												FontSize="12"/>

										<StackPanel Spacing="2" IsVisible="{Binding IsLinuxPlatform}">
											<TextBlock Text="LINUX WINDOWS RUNNER"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource TextSecondary}"
													   LetterSpacing="1"
													   Margin="0,8,0,4"/>
											<TextBox x:Name="LinuxWindowsLaunchCommandTextBox"
													 Foreground="{DynamicResource TextPrimary}"
													 Background="{DynamicResource Surface}"
													 BorderBrush="{DynamicResource Border}"
													 BorderThickness="1"
													 Padding="12,10"
													 CornerRadius="4"
													 Watermark="Example: flatpak run com.usebottles.bottles -e {exe}"
													 Text="{Binding Settings.LinuxWindowsLaunchCommand, Mode=TwoWay}"
													 TextChanged="LinuxWindowsLaunchCommandTextBox_TextChanged"/>
											<TextBlock Text="Optional override for Windows-only apps on Linux. Use {exe}, {appPath}, or {exeDir}. Leave blank to auto-detect Wine/Proton."
													   FontSize="11"
													   TextWrapping="Wrap"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="0,0,0,4"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- Appearance Tab -->
								<TabItem Header="Appearance">
									<StackPanel Margin="0,16,0,24" Spacing="8">

										<!-- Window -->
										<TextBlock Text="WINDOW"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="StartFullscreenCheckBox"
													  Content="Start in Fullscreen"
													  Foreground="{DynamicResource TextPrimary}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="StartFullscreenCheckBox_Checked"
													  Unchecked="StartFullscreenCheckBox_Unchecked"/>
											<TextBlock Text="Launch the application in fullscreen mode"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2">
											<CheckBox x:Name="RoundWindowCornersCheckBox"
													  Content="Rounded Window Corners"
													  Foreground="{DynamicResource TextPrimary}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="RoundWindowCornersCheckBox_Checked"
													  Unchecked="RoundWindowCornersCheckBox_Unchecked"/>
											<TextBlock Text="Apply rounded corners to the launcher window"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2">
											<CheckBox x:Name="ShowOSTopBarCheckBox"
													  Content="Show OS Top Bar"
													  Foreground="{DynamicResource TextPrimary}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="ShowOSTopBarCheckBox_Checked"
													  Unchecked="ShowOSTopBarCheckBox_Unchecked"/>
											<TextBlock Text="Display your operating system's title bar"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>


										<!-- Theme Presets -->
										<TextBlock Text="THEME PRESETS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Orientation="Horizontal" Spacing="8">
											<Button Classes="options"
													Content="Dark Preset"
													FontSize="12"
													Click="ThemePresetDark_Click"/>
											<Button Classes="options"
													Content="Light Preset"
													FontSize="12"
													Click="ThemePresetLight_Click"/>
										</StackPanel>
										<Button Classes="options"
												Content="Midnight Purple Preset"
												HorizontalAlignment="Stretch"
												Click="ThemePresetMidnight_Click"
												FontSize="12"/>

										<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
											<Button Classes="options"
													Content="Import"
													FontSize="12"
													Click="ImportTheme_Click"/>
											<Button Classes="options"
													Content="Export"
													FontSize="12"
													Click="ExportTheme_Click"/>
											<Button Classes="options"
													Content="Reset"
													FontSize="12"
													Click="ResetTheme_Click"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- Theme Tokens -->
										<TextBlock Text="THEME TOKENS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel x:Name="ThemeTokenEditorPanel"
													Spacing="6"
													Margin="0,0,0,4"/>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- Theme Layout -->
										<TextBlock Text="THEME LAYOUT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Card radius:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ThemeCardRadiusSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ThemeCardRadiusSlider"
													Minimum="0" Maximum="32"
													TickFrequency="1"
													IsSnapToTickEnabled="True"
													ValueChanged="ThemeCardRadiusSlider_ValueChanged"/>
										</StackPanel>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Control radius:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ThemeControlRadiusSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ThemeControlRadiusSlider"
													Minimum="0" Maximum="24"
													TickFrequency="1"
													IsSnapToTickEnabled="True"
													ValueChanged="ThemeControlRadiusSlider_ValueChanged"/>
										</StackPanel>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Surface opacity:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ThemeSurfaceOpacitySlider, Path=Value, StringFormat={}{0:F2}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ThemeSurfaceOpacitySlider"
													Minimum="0.2" Maximum="1"
													TickFrequency="0.01"
													IsSnapToTickEnabled="True"
													ValueChanged="ThemeSurfaceOpacitySlider_ValueChanged"/>
										</StackPanel>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Sidebar width:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ThemeSidebarWidthSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ThemeSidebarWidthSlider"
													Minimum="240" Maximum="360"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="ThemeSidebarWidthSlider_ValueChanged"/>
										</StackPanel>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Main padding:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ThemeMainPaddingSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ThemeMainPaddingSlider"
													Minimum="8" Maximum="48"
													TickFrequency="2"
													IsSnapToTickEnabled="True"
													ValueChanged="ThemeMainPaddingSlider_ValueChanged"/>
										</StackPanel>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Card density:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ThemeCardDensitySlider, Path=Value, StringFormat={}{0:F2}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ThemeCardDensitySlider"
													Minimum="0.75" Maximum="1.35"
													TickFrequency="0.05"
													IsSnapToTickEnabled="True"
													ValueChanged="ThemeCardDensitySlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- Background Image -->
										<TextBlock Text="BACKGROUND IMAGE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="PNG, JPG, and GIF formats supported"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Select Image"
												HorizontalAlignment="Stretch"
												Click="SelectBackgroundImage_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="Clear Background"
												HorizontalAlignment="Stretch"
												Click="ClearBackgroundImage_Click"
												IsEnabled="{Binding BackgroundImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
												FontSize="12"/>

										<StackPanel Spacing="4" Margin="0,4,0,0">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Opacity:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=BackgroundOpacitySlider, Path=Value, StringFormat={}{0:F2}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="BackgroundOpacitySlider"
													Minimum="0" Maximum="1"
													Value="{Binding BackgroundOpacity}"
													TickFrequency="0.01"
													IsSnapToTickEnabled="True"
													ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- Background Music -->
										<TextBlock Text="BACKGROUND MUSIC"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="MP3, WAV, and OGG formats supported"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Select Music"
												HorizontalAlignment="Stretch"
												Click="SelectLauncherMusic_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="Clear Music"
												HorizontalAlignment="Stretch"
												Click="ClearLauncherMusic_Click"
												IsEnabled="{Binding LauncherMusicPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
												FontSize="12"/>

										<StackPanel Spacing="4" Margin="0,4,0,0">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Volume:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=MusicVolumeSlider, Path=Value, StringFormat={}{0:F2}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="MusicVolumeSlider"
													Minimum="0" Maximum="1"
													Value="{Binding MusicVolume}"
													TickFrequency="0.01"
													IsSnapToTickEnabled="True"
													ValueChanged="MusicVolumeSlider_ValueChanged"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- App Cards Tab -->
								<TabItem Header="App Cards">
									<StackPanel Margin="0,16,0,24" Spacing="8">

										<!-- Layout -->
										<TextBlock Text="LAYOUT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="UseGridViewCheckBox"
													  Content="Grid View"
													  Foreground="{DynamicResource TextPrimary}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="UseGridViewCheckBox_Checked"
													  Unchecked="UseGridViewCheckBox_Unchecked"/>
											<TextBlock Text="Display apps in a grid instead of a list"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="6" Margin="0,4,0,0">
											<TextBlock Text="Presets"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"/>
											<StackPanel Orientation="Horizontal" Spacing="8">
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Landscape_Click"
														ToolTip.Tip="Landscape">
													<Image Width="52" Height="52" Source="avares://GithubLauncher/Assets/Icons/preset_landscape.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Square_Click"
														ToolTip.Tip="Square">
													<Image Width="52" Height="52" Source="avares://GithubLauncher/Assets/Icons/preset_square.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Portrait_Click"
														ToolTip.Tip="Portrait">
													<Image Width="52" Height="52" Source="avares://GithubLauncher/Assets/Icons/preset_portrait.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_List_Click"
														ToolTip.Tip="List">
													<Image Width="52" Height="52" Source="avares://GithubLauncher/Assets/Icons/preset_list.png"/>
												</Button>
											</StackPanel>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- Card Size -->
										<TextBlock Text="CARD SIZE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Size:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=SlotSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="SlotSizeSlider"
													Minimum="120" Maximum="400"
													Value="120"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="SlotSizeSlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- App Images -->
										<TextBlock Text="GAME IMAGES"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<!-- Size -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Size:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="11"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconSizeSlider"
													Minimum="64" Maximum="512"
													Value="256"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="IconSizeSlider_ValueChanged"/>
										</StackPanel>

										<!-- Custom Image Fill -->
										<StackPanel Spacing="2">
											<CheckBox x:Name="IconFillCheckBox"
													  Content="Fill Cards"
													  Foreground="{DynamicResource TextPrimary}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="IconFillCheckBox_Checked"
													  Unchecked="IconFillCheckBox_Unchecked"/>
											<TextBlock Text="Stretch images to fill entire cards"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<!-- Image Opacity -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Card Image Opacity:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconOpacitySlider, Path=Value, StringFormat={}{0:F1}}"
														   FontSize="11"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconOpacitySlider"
													Minimum="0.0" Maximum="1.0"
													Value="0.2"
													TickFrequency="0.1"
													IsSnapToTickEnabled="True"
													ValueChanged="IconOpacitySlider_ValueChanged"/>
											<TextBlock Text="Control image transparency"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"/>
										</StackPanel>

										<!-- Left Padding -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Left Padding:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconMarginSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="11"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconMarginSlider"
													Minimum="0" Maximum="512"
													Value="0"
													TickFrequency="8"
													IsSnapToTickEnabled="True"
													ValueChanged="IconMarginSlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- Text -->
										<TextBlock Text="TEXT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Text Padding:"
														   FontSize="12"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=TextMarginSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource TextSecondary}"/>
											</StackPanel>
											<Slider x:Name="TextMarginSlider"
													Minimum="0" Maximum="256"
													Value="0"
													TickFrequency="8"
													IsSnapToTickEnabled="True"
													ValueChanged="TextMarginSlider_ValueChanged"/>
											<TextBlock Text="Adjust the left spacing of text labels"
													   FontSize="11"
													   Foreground="{DynamicResource TextSecondary}"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- Advanced Tab -->
								<TabItem Header="Advanced">
									<StackPanel Margin="0,16,0,24" Spacing="8">

										<!-- App List Repositories -->
										<TextBlock Text="APP LIST REPOSITORIES"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="GitHub repositories used as catalog sources. Each must release versioned apps.json files."
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,8"/>

										<!-- Dynamically populated repository rows -->
										<StackPanel x:Name="RepositoryListPanel" Spacing="6" Margin="0,0,0,4"/>

										<!-- Action buttons -->
										<Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
											<Button Grid.Column="0" Classes="options"
													Content="+ Add Repository"
													HorizontalAlignment="Stretch"
													Click="AddRepositoryButton_Click"
													FontSize="12"/>
											<Button Grid.Column="1" Classes="options"
													Content="↺ Reset to Default"
													Margin="8,0,0,0"
													Click="ResetAppListRepository_Click"
													FontSize="12"/>
										</Grid>

										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<!-- GitHub API Token -->
										<TextBlock Text="GITHUB API TOKEN"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource TextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="Increases API rate limits for faster and more reliable downloads"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,6"/>

										<TextBox x:Name="GitHubTokenTextBox"
												 Foreground="{DynamicResource TextPrimary}"
												 Background="{DynamicResource Surface}"
												 BorderBrush="{DynamicResource Border}"
												 BorderThickness="1"
												 Padding="12,10"
												 CornerRadius="4"
												 TextChanged="GitHubTokenTextBox_TextChanged"
												 Text="{Binding Settings.GitHubApiToken, Mode=TwoWay}"/>

										<Button Classes="options"
												Content="Create GitHub Token"
												HorizontalAlignment="Stretch"
												Click="CreateGitHubToken_Click"
												FontSize="12"/>

										<Button Classes="options"
												Content="Clear Token"
												HorizontalAlignment="Stretch"
												Click="ClearGitHubToken_Click"
												FontSize="12"/>

										<Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,8"/>

										<TextBlock Text="Visit GitHub's token documentation for more information on generating a personal access token."
												   FontSize="10"
												   Foreground="{DynamicResource TextSecondary}"
												   FontStyle="Italic"
												   TextWrapping="Wrap"/>

									</StackPanel>
								</TabItem>

							</TabControl>
						</StackPanel>
					</ScrollViewer>
				</Border>
				
				<!-- Changelog Panel -->
				<Border x:Name="ChangelogPanel"
						Grid.RowSpan="2"
						Background="{DynamicResource BackgroundBase}"
						IsVisible="False"
						ZIndex="100">
					<Grid>
						<ScrollViewer VerticalScrollBarVisibility="Auto"
									  Margin="40">
							<StackPanel MaxWidth="900">
								<TextBlock x:Name="ChangelogTitle"
										   Text="Changelog"
										   FontSize="28"
										   FontWeight="Bold"
										   Foreground="{DynamicResource TextPrimary}"
										   Margin="0,0,0,20"/>
								<ItemsControl x:Name="ChangelogContent"
											  ItemsSource="{Binding}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<ContentControl Content="{Binding}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Manage Apps Panel -->
				<Border x:Name="ManageGamesPanel"
						Grid.RowSpan="2"
						Background="{DynamicResource BackgroundBase}"
						IsVisible="False"
						ZIndex="100">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<!-- App Manager Navigation Bar -->
						<Border Grid.Row="0"
								Background="{DynamicResource BackgroundBase}"
								BorderBrush="{DynamicResource Border}"
								BorderThickness="0,0,0,1"
								Padding="40,10">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button x:Name="NavManageAppsButton"
										Classes="options"
										Content="Manage Apps"
										FontSize="12"
										Click="NavManageApps_Click"/>
								<Button x:Name="NavAppBrowserButton"
										Classes="options"
										Content="App Catalog"
										FontSize="12"
										Click="NavAppBrowser_Click"/>
							</StackPanel>
						</Border>

						<Grid Grid.Row="1">
							<ScrollViewer x:Name="ManageGamesTab" VerticalScrollBarVisibility="Auto" Margin="40" IsVisible="True">
								<StackPanel Spacing="20">
					
									<Border Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="16">
										<StackPanel Spacing="12">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<TextBlock Grid.Column="0"
														   Text="APPS"
														   FontSize="16"
														   FontWeight="Bold"
														   Foreground="{DynamicResource TextPrimary}"
														   VerticalAlignment="Center"/>
												<Button Grid.Column="1"
														Classes="options"
														Content="Unhide All"
														FontSize="12"
														Tag="Apps"
														Click="UnhideAllManuallyHidden_Click"/>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}" Margin="0,4,0,8"/>
							
											<ItemsControl x:Name="CustomGamesListControl">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Background="{DynamicResource Surface}"
																BorderBrush="{DynamicResource Border}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="12"
																Margin="0,8,0,0">
															<Grid>
																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="80"/>
																	<ColumnDefinition Width="*"/>
																	<ColumnDefinition Width="Auto"/>
																</Grid.ColumnDefinitions>

																<asyncImageLoader:AdvancedImage Grid.Column="0"
																								Source="{Binding IconUrl}"
																								Width="128"
																								Height="128"
																								VerticalAlignment="Center"
																								HorizontalAlignment="Left"
																								Stretch="Uniform"/>

																<StackPanel Grid.Column="1" Spacing="4" Margin="76,0,0,0">
																	<TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
																	<TextBlock Text="{Binding Repository}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
																	<TextBlock Text="{Binding FolderName}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
																</StackPanel>

																<StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4">
																	<Button Classes="options"
																			Content="Edit"
																			FontSize="12"
																			Width="80"
																			Click="EditGameEntry_Click"
																			Tag="{Binding}"/>
																	<Button Classes="options"
																			Content="{Binding HideGameLabel}"
																			FontSize="12"
																			Width="80"
																			Click="ToggleHideGame_Click"
																			Tag="{Binding}"/>
																	<Button Classes="options"
																			Content="Remove"
																			FontSize="12"
																			Width="80"
																			Click="RemoveGameEntry_Click"
																			Tag="{Binding}"
																			IsVisible="{Binding CanRemove}"/>
																</StackPanel>
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>

											<Button Classes="options"
													Content="+ Add New App"
													HorizontalAlignment="Stretch"
													Height="44"
													Margin="0,8,0,0"
													Click="SwitchToCreateEditTab"/>
										</StackPanel>
									</Border>
								</StackPanel>
							</ScrollViewer>

							<ScrollViewer x:Name="CreateEditTab" VerticalScrollBarVisibility="Auto" Margin="40" IsVisible="False">
								<StackPanel Spacing="20">
									<Border Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="16">
										<StackPanel Spacing="12">
											<TextBlock x:Name="FormTitleText"
													   Text="Create New Entry"
													   FontSize="18"
													   FontWeight="Bold"
													   Foreground="{DynamicResource TextPrimary}"/>
											<Border Height="1" Background="{DynamicResource Border}" Margin="0,4,0,8"/>
							
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="*"/>
												</Grid.ColumnDefinitions>
												<Grid.RowDefinitions>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="Auto"/>
												</Grid.RowDefinitions>

												<TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
												<TextBox Grid.Row="0" Grid.Column="1" 
														 x:Name="NewGameNameTextBox"
														 Foreground="{DynamicResource TextPrimary}"
														 Background="{DynamicResource Surface}"
														 BorderBrush="{DynamicResource Border}"
														 BorderThickness="1"
														 CornerRadius="4"
														 Padding="8"
														 Margin="8,0,0,0"
														 TextChanged="GameNameTextBox_TextChanged"/>

												<TextBlock Grid.Row="1" Grid.Column="0" Text="Repository:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
												<TextBox Grid.Row="1" Grid.Column="1" 
														 x:Name="NewGameRepoTextBox"
														 Foreground="{DynamicResource TextPrimary}"
														 Background="{DynamicResource Surface}"
														 BorderBrush="{DynamicResource Border}"
														 BorderThickness="1"
														 CornerRadius="4"
														 Padding="8"
														 Margin="8,0,0,0"
														 TextChanged="GameRepoTextBox_TextChanged"/>

												<TextBlock Grid.Row="2" Grid.Column="0" Text="Folder Name:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
												<TextBox Grid.Row="2" Grid.Column="1" 
														 x:Name="NewGameFolderTextBox"
														 Foreground="{DynamicResource TextPrimary}"
														 Background="{DynamicResource Surface}"
														 BorderBrush="{DynamicResource Border}"
														 BorderThickness="1"
														 CornerRadius="4"
														 Padding="8"
														 Margin="8,0,0,0"
														 TextChanged="GameFolderTextBox_TextChanged"/>

												<TextBlock Grid.Row="3" Grid.Column="0" Text="Icon URL:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
												<TextBox Grid.Row="3" Grid.Column="1" 
														 x:Name="NewGameIconTextBox"
														 Foreground="{DynamicResource TextPrimary}"
														 Background="{DynamicResource Surface}"
														 BorderBrush="{DynamicResource Border}"
														 BorderThickness="1"
														 CornerRadius="4"
														 Padding="8"
														 Margin="8,0,0,0"
														 TextChanged="GameIconTextBox_TextChanged"/>
											</Grid>

											<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
												<Button x:Name="CancelButton"
														Classes="options"
														Content="Cancel"
														FontSize="12"
														Width="100"
														Click="CancelForm_Click"/>
												<Button x:Name="CreateEditButton"
														Classes="options"
														Content="Create Entry"
														FontSize="12"
														Width="120"
														Click="CreateNewEntry_Click"/>
											</StackPanel>
										</StackPanel>
									</Border>

									<Border Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="12">
										<TextBlock x:Name="ValidationStatusText"
												   Text=""
												   Foreground="{DynamicResource TextPrimary}"
												   FontSize="12"
												   TextWrapping="Wrap"/>
									</Border>
								</StackPanel>
							</ScrollViewer>

							<!-- App Browser Tab -->
							<ScrollViewer x:Name="AppBrowserTab" VerticalScrollBarVisibility="Auto" Margin="40" IsVisible="False">
								<StackPanel Spacing="20">

									<Border Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="16">
										<StackPanel Spacing="12">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<StackPanel Grid.Column="0" Spacing="2">
													<TextBlock Text="APP CATALOG"
															   FontSize="16"
															   FontWeight="Bold"
															   Foreground="{DynamicResource TextPrimary}"
															   VerticalAlignment="Center"/>
													<TextBlock x:Name="AppCatalogVersionText"
															   Text=""
															   FontSize="11"
															   Foreground="{DynamicResource TextSecondary}"/>
												</StackPanel>
												<Button Grid.Column="1"
														Classes="options"
														Content="Refresh"
														FontSize="12"
														Click="RefreshAppCatalog_Click"/>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}" Margin="0,4,0,4"/>
											<Grid ColumnSpacing="8">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<TextBox Grid.Column="0"
														 x:Name="AppCatalogSearchTextBox"
														 Watermark="Search apps or categories..."
														 Foreground="{DynamicResource TextPrimary}"
														 Background="{DynamicResource Surface}"
														 BorderBrush="{DynamicResource Border}"
														 BorderThickness="1"
														 Padding="12,10"
														 CornerRadius="4"
														 TextChanged="AppCatalogSearchTextBox_TextChanged"/>
												<ComboBox Grid.Column="1"
														  x:Name="AppCatalogCategoryFilterComboBox"
														  Width="160"
														  Foreground="{DynamicResource TextPrimary}"
														  Background="{DynamicResource Surface}"
														  BorderBrush="{DynamicResource Border}"
														  SelectionChanged="AppCatalogCategoryFilterComboBox_SelectionChanged"/>
											</Grid>
											<TextBlock x:Name="AppCatalogStatusText"
													   Text="Loading catalog..."
													   FontSize="12"
													   Foreground="{DynamicResource TextSecondary}"
													   IsVisible="True"/>
											<StackPanel x:Name="AppCatalogContent" Spacing="16" IsVisible="False"/>
										</StackPanel>
									</Border>

								</StackPanel>
							</ScrollViewer>

						</Grid>
					</Grid>
				</Border>

				<!-- Activity Panel -->
				<Border x:Name="ActivityPanel"
						Grid.RowSpan="2"
						Background="{DynamicResource BackgroundBase}"
						IsVisible="False"
						ZIndex="100">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<Border Grid.Row="0"
								Background="{DynamicResource BackgroundBase}"
								BorderBrush="{DynamicResource Border}"
								BorderThickness="0,0,0,1"
								Padding="40,10">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button x:Name="ActivityPeriodDayButton"
										Classes="options"
										Content="Day"
										FontSize="12"
										Click="ActivityPeriodDay_Click"/>
								<Button x:Name="ActivityPeriodWeekButton"
										Classes="options"
										Content="Week"
										FontSize="12"
										Click="ActivityPeriodWeek_Click"/>
								<Button x:Name="ActivityPeriodMonthButton"
										Classes="options"
										Content="Month"
										FontSize="12"
										Click="ActivityPeriodMonth_Click"/>
							</StackPanel>
						</Border>

						<Border Grid.Row="1"
								Background="{DynamicResource BackgroundBase}"
								BorderBrush="{DynamicResource Border}"
								BorderThickness="0,0,0,1"
								Padding="40,10">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button x:Name="ActivityTabOverviewButton"
										Classes="options active"
										Content="Overview"
										FontSize="12"
										Click="ActivityTabOverview_Click"/>
								<Button x:Name="ActivityTabHeatmapButton"
										Classes="options"
										Content="Heatmap"
										FontSize="12"
										Click="ActivityTabHeatmap_Click"/>
								<Button x:Name="ActivityTabPatternsButton"
										Classes="options"
										Content="Patterns"
										FontSize="12"
										Click="ActivityTabPatterns_Click"/>
								<Button x:Name="ActivityTabCompareButton"
										Classes="options"
										Content="Compare"
										FontSize="12"
										Click="ActivityTabCompare_Click"/>
							</StackPanel>
						</Border>

						<Grid Grid.Row="2">

						<ScrollViewer x:Name="ActivityOverviewTab" VerticalScrollBarVisibility="Auto" Margin="40" IsVisible="True">
							<StackPanel Spacing="20">

								<!-- Summary Cards -->
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0"
											Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="16"
											Margin="0,0,8,0">
										<StackPanel>
											<TextBlock Text="TOTAL PLAYTIME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="ActivityTotalPlaytimeText" Text="0m" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="1"
											Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="16"
											Margin="4,0,4,0">
										<StackPanel>
											<TextBlock Text="SESSIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="ActivityTotalSessionsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="2"
											Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="16"
											Margin="8,0,0,0">
										<StackPanel>
											<TextBlock Text="MOST PLAYED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="ActivityMostPlayedText" Text="-" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
										</StackPanel>
									</Border>
								</Grid>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0"
											Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="16"
											Margin="0,0,4,0">
										<StackPanel>
											<TextBlock Text="AVG SESSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="ActivityAvgSessionText" Text="0m" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="1"
											Background="{DynamicResource BackgroundBase}"
											BorderBrush="{DynamicResource Border}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="16"
											Margin="4,0,0,0">
										<StackPanel>
											<TextBlock Text="STREAK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="ActivityStreakText" Text="0 days" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>
								</Grid>

								<!-- Chart -->
								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Grid.Column="0" Text="PLAYTIME" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
											<ComboBox Grid.Column="1"
													  x:Name="ActivityChartGameFilter"
													  Width="160"
													  SelectionChanged="ActivityChartGameFilter_SelectionChanged"/>
										</Grid>
										<TextBlock x:Name="ActivityComparisonText" Text="" FontSize="12" FontWeight="Bold"/>
										<Border Height="1" Background="{DynamicResource Border}"/>
										<lvc:CartesianChart x:Name="ActivityChart" Height="240"/>
									</StackPanel>
								</Border>

								<!-- Ranking -->
								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<TextBlock Text="MOST PLAYED GAMES" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
										<Border Height="1" Background="{DynamicResource Border}"/>

										<ItemsControl x:Name="ActivityRankingList">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Button Classes="activityrow"
															Click="ActivityRankingRow_Click">
														<Grid>
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="*"/>
																<ColumnDefinition Width="Auto"/>
																<ColumnDefinition Width="Auto"/>
															</Grid.ColumnDefinitions>
															<TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
															<TextBlock Grid.Column="1" Text="{Binding SessionsLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
															<TextBlock Grid.Column="2" Text="{Binding TotalLabel}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
														</Grid>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<TextBlock x:Name="ActivityRankingEmptyText"
												   Text="No play sessions recorded yet."
												   Foreground="{DynamicResource TextSecondary}"
												   IsVisible="False"/>
									</StackPanel>
								</Border>

							</StackPanel>
						</ScrollViewer>

						<ScrollViewer x:Name="ActivityHeatmapTab" VerticalScrollBarVisibility="Auto" Margin="40" IsVisible="False">
							<StackPanel Spacing="20">

								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Text="ACTIVITY HEATMAP" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
									<ComboBox Grid.Column="1"
											  x:Name="ActivityHeatmapGameFilter"
											  Width="160"
											  SelectionChanged="ActivityHeatmapGameFilter_SelectionChanged"/>
								</Grid>

								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
											<WrapPanel x:Name="ActivityHeatmapGrid" Orientation="Vertical" Height="112"/>
										</ScrollViewer>
										<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
											<TextBlock Text="Less" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
											<ItemsControl x:Name="ActivityHeatmapLegend">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel Orientation="Horizontal" Spacing="4"/>
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Width="12" Height="12" CornerRadius="2" Background="{Binding}"/>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
											<TextBlock Text="More" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
										</StackPanel>
									</StackPanel>
								</Border>

							</StackPanel>
						</ScrollViewer>

						<ScrollViewer x:Name="ActivityPatternsTab" VerticalScrollBarVisibility="Auto" Margin="40" IsVisible="False">
							<StackPanel Spacing="20">

								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Text="PLAY PATTERNS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
									<ComboBox Grid.Column="1"
											  x:Name="ActivityPatternsGameFilter"
											  Width="160"
											  SelectionChanged="ActivityPatternsGameFilter_SelectionChanged"/>
								</Grid>

								<TextBlock x:Name="ActivityPatternInsight" Text="" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<TextBlock Text="BY DAY OF WEEK" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
										<lvc:CartesianChart x:Name="ActivityWeekdayChart" Height="200"/>
									</StackPanel>
								</Border>

								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<TextBlock Text="BY HOUR OF DAY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
										<lvc:CartesianChart x:Name="ActivityHourChart" Height="200"/>
									</StackPanel>
								</Border>

							</StackPanel>
						</ScrollViewer>

						<ScrollViewer x:Name="ActivityCompareTab" VerticalScrollBarVisibility="Auto" Margin="40" IsVisible="False">
							<StackPanel Spacing="20">

								<TextBlock Text="COMPARE GAMES" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>

								<Grid ColumnDefinitions="*,*">
									<ComboBox Grid.Column="0"
											  x:Name="ActivityCompareGameA"
											  Width="220"
											  HorizontalAlignment="Left"
											  SelectionChanged="ActivityCompareGame_SelectionChanged"/>
									<ComboBox Grid.Column="1"
											  x:Name="ActivityCompareGameB"
											  Width="220"
											  HorizontalAlignment="Left"
											  SelectionChanged="ActivityCompareGame_SelectionChanged"/>
								</Grid>

								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
										<TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActivityCompareNameA" Text="-" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="12,0"/>
										<TextBlock Grid.Row="0" Grid.Column="2" x:Name="ActivityCompareNameB" Text="-" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="12,0"/>
										<Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{DynamicResource Border}" Margin="0,8"/>

										<TextBlock Grid.Row="2" Grid.Column="0" Text="Total playtime" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,4"/>
										<TextBlock Grid.Row="2" Grid.Column="1" x:Name="ActivityCompareTotalA" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>
										<TextBlock Grid.Row="2" Grid.Column="2" x:Name="ActivityCompareTotalB" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>

										<TextBlock Grid.Row="3" Grid.Column="0" Text="Sessions" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,4"/>
										<TextBlock Grid.Row="3" Grid.Column="1" x:Name="ActivityCompareSessionsA" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>
										<TextBlock Grid.Row="3" Grid.Column="2" x:Name="ActivityCompareSessionsB" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>

										<TextBlock Grid.Row="4" Grid.Column="0" Text="Avg session" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,4"/>
										<TextBlock Grid.Row="4" Grid.Column="1" x:Name="ActivityCompareAvgA" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>
										<TextBlock Grid.Row="4" Grid.Column="2" x:Name="ActivityCompareAvgB" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>

										<TextBlock Grid.Row="5" Grid.Column="0" Text="Longest session" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,4"/>
										<TextBlock Grid.Row="5" Grid.Column="1" x:Name="ActivityCompareLongestA" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>
										<TextBlock Grid.Row="5" Grid.Column="2" x:Name="ActivityCompareLongestB" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>

										<TextBlock Grid.Row="6" Grid.Column="0" Text="First played" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,4"/>
										<TextBlock Grid.Row="6" Grid.Column="1" x:Name="ActivityCompareFirstA" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>
										<TextBlock Grid.Row="6" Grid.Column="2" x:Name="ActivityCompareFirstB" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>

										<TextBlock Grid.Row="7" Grid.Column="0" Text="Last played" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,4"/>
										<TextBlock Grid.Row="7" Grid.Column="1" x:Name="ActivityCompareLastA" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>
										<TextBlock Grid.Row="7" Grid.Column="2" x:Name="ActivityCompareLastB" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="12,4"/>
									</Grid>
								</Border>

								<TextBlock x:Name="ActivityCompareEmptyText" Text="Choose two games to compare." Foreground="{DynamicResource TextSecondary}"/>

							</StackPanel>
						</ScrollViewer>

						</Grid>
					</Grid>
				</Border>

				<!-- Game Profile Panel -->
				<Border x:Name="GameProfilePanel"
						Grid.RowSpan="2"
						Background="{DynamicResource BackgroundBase}"
						IsVisible="False"
						ZIndex="110">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<Border Grid.Row="0"
								Background="{DynamicResource BackgroundBase}"
								BorderBrush="{DynamicResource Border}"
								BorderThickness="0,0,0,1"
								Padding="40,10">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock Grid.Column="0"
										   x:Name="GameProfileTitle"
										   Text="GAME PROFILE"
										   FontSize="16"
										   FontWeight="Bold"
										   Foreground="{DynamicResource TextPrimary}"
										   VerticalAlignment="Center"/>
								<Button Grid.Column="1"
										Classes="options"
										Content="Close"
										FontSize="12"
										Click="CloseGameProfile_Click"/>
							</Grid>
						</Border>

						<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="40">
							<StackPanel Spacing="20">

								<Border CornerRadius="12" ClipToBounds="True" Height="220">
									<asyncImageLoader:AdvancedImage x:Name="GameProfileHeroImage"
																	 Stretch="UniformToFill"/>
								</Border>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0" Background="{DynamicResource BackgroundBase}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,4,0">
										<StackPanel>
											<TextBlock Text="TOTAL PLAYTIME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="GameProfileTotalText" Text="0m" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>
									<Border Grid.Column="1" Background="{DynamicResource BackgroundBase}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0">
										<StackPanel>
											<TextBlock Text="SESSIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="GameProfileSessionsText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>
									<Border Grid.Column="2" Background="{DynamicResource BackgroundBase}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0">
										<StackPanel>
											<TextBlock Text="LONGEST SESSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="GameProfileLongestText" Text="0m" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>
									<Border Grid.Column="3" Background="{DynamicResource BackgroundBase}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,0,0">
										<StackPanel>
											<TextBlock Text="PLAY DAYS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="GameProfilePlayDaysText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>
								</Grid>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0" Background="{DynamicResource BackgroundBase}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,4,0">
										<StackPanel>
											<TextBlock Text="FIRST PLAYED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="GameProfileFirstPlayedText" Text="-" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>
									<Border Grid.Column="1" Background="{DynamicResource BackgroundBase}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0">
										<StackPanel>
											<TextBlock Text="LAST PLAYED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="GameProfileLastPlayedText" Text="-" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>
									<Border Grid.Column="2" Background="{DynamicResource BackgroundBase}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,0,0">
										<StackPanel>
											<TextBlock Text="INSTALLED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="1"/>
											<TextBlock x:Name="GameProfileInstalledText" Text="-" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
										</StackPanel>
									</Border>
								</Grid>

								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<TextBlock Text="SESSION HISTORY" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
										<Border Height="1" Background="{DynamicResource Border}"/>

										<ItemsControl x:Name="GameProfileSessionList">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Grid Margin="0,6,0,0">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
															<ColumnDefinition Width="Auto"/>
														</Grid.ColumnDefinitions>
														<TextBlock Grid.Column="0" Text="{Binding DateLabel}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
														<TextBlock Grid.Column="1" Text="{Binding DurationLabel}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
														<Button Grid.Column="2"
																Classes="options"
																Content="✕"
																FontSize="12"
																Click="DeleteActivitySession_Click"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>

							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<Border x:Name="DownloadsPanel"
						Grid.RowSpan="2"
						Background="{DynamicResource BackgroundBase}"
						IsVisible="False"
						ZIndex="100">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="40">
							<StackPanel Spacing="20">

								<!-- Active Downloads -->
								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<TextBlock Text="ACTIVE DOWNLOADS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
										<Border Height="1" Background="{DynamicResource Border}"/>

										<ItemsControl x:Name="ActiveDownloadsList">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Grid Margin="0,6" ColumnDefinitions="*,Auto">
														<StackPanel Grid.Column="0" Spacing="6">
															<Grid ColumnDefinitions="*,Auto">
																<TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
																<TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
															</Grid>
															<ProgressBar Value="{Binding DownloadProgress}"
																		 Minimum="0"
																		 Maximum="100"
																		 Height="6"
																		 Background="{DynamicResource SurfaceAlt}"
																		 Foreground="{Binding ProgressBarColor}"
																		 BorderThickness="0"/>
														</StackPanel>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<TextBlock x:Name="ActiveDownloadsEmptyText"
												   Text="No active downloads right now."
												   Foreground="{DynamicResource TextSecondary}"
												   IsVisible="False"/>
									</StackPanel>
								</Border>

								<!-- Download History -->
								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Grid.Column="0" Text="DOWNLOAD HISTORY" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
											<Button Grid.Column="1"
													Classes="options"
													Content="Clear history"
													FontSize="12"
													Click="ClearDownloadHistory_Click"/>
										</Grid>
										<Border Height="1" Background="{DynamicResource Border}"/>

										<ItemsControl x:Name="DownloadHistoryList">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto,Auto">
														<TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
														<TextBlock Grid.Column="1" Text="{Binding KindVersionLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
														<TextBlock Grid.Column="2" Text="{Binding CompletedAtLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<TextBlock x:Name="DownloadHistoryEmptyText"
												   Text="No completed downloads yet."
												   Foreground="{DynamicResource TextSecondary}"
												   IsVisible="False"/>
									</StackPanel>
								</Border>

							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Notifications Panel -->
				<Border x:Name="NotificationsPanel"
						Grid.RowSpan="2"
						Background="{DynamicResource BackgroundBase}"
						IsVisible="False"
						ZIndex="100">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="40">
							<StackPanel Spacing="20">

								<Border Background="{DynamicResource BackgroundBase}"
										BorderBrush="{DynamicResource Border}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16">
									<StackPanel Spacing="12">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Grid.Column="0" Text="NOTIFICATIONS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
											<Button Grid.Column="1"
													Classes="options"
													Content="Clear"
													FontSize="12"
													Click="ClearNotifications_Click"/>
										</Grid>
										<Border Height="1" Background="{DynamicResource Border}"/>

										<ItemsControl x:Name="NotificationsList">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*,Auto">
														<Border Grid.Column="0"
																Width="8" Height="8"
																CornerRadius="4"
																Margin="0,0,10,0"
																VerticalAlignment="Center"
																Background="{Binding AccentBrush}"/>
														<StackPanel Grid.Column="1" Spacing="2">
															<TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"/>
															<TextBlock Text="{Binding Body}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
														</StackPanel>
														<TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Top"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<TextBlock x:Name="NotificationsEmptyText"
												   Text="No notifications yet."
												   Foreground="{DynamicResource TextSecondary}"
												   IsVisible="False"/>
									</StackPanel>
								</Border>

							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

			</Grid>
		</Grid>
	</Grid>
  </Border>
</Window>
